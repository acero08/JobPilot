# Copy to backend/.env and adjust.
# Loopback only. Other addresses are refused unless JOBPILOT_ALLOW_NON_LOOPBACK=1.
JOBPILOT_HOST=127.0.0.1
JOBPILOT_ALLOW_NON_LOOPBACK=0
JOBPILOT_PORT=8000
JOBPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where profiles, resumes and the browser login profile are stored
JOBPILOT_DATA_DIR=./data
# 1 = run Chromium without a window
JOBPILOT_HEADLESS=0
# How long to wait for the application form to render (ms)
JOBPILOT_PAGE_SETTLE_MS=2500
# Largest resume accepted, in megabytes
JOBPILOT_MAX_UPLOAD_MB=10
